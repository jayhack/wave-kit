{
  "name": "@jayhack/wave-kit",
  "version": "0.4.1",
  "description": "The open React component system and generative wave language behind jay.ai.",
  "license": "MIT",
  "author": "Jay Hack",
  "homepage": "https://jay.ai/design",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jayhack/wave-kit.git"
  },
  "keywords": [
    "react",
    "components",
    "design-system",
    "lightbox",
    "generative-art",
    "jay-ai"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "wave-kit": "bin/wave-kit.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "test": "tsc -p tsconfig.build.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.3.0",
    "react-dom": ">=18.3.0",
    "tailwindcss": ">=4.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=18"
  }
}
